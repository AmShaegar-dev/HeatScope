<Window x:Class="HeatScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeatScope — монитор нагрева ПК"
        Height="880" Width="1460" MinHeight="640" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Icon="Assets/HeatScope.ico"
        FontFamily="Segoe UI">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/logo-64.png" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="HeatScope" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                <TextBlock Text="монитор нагрева и виновников" Margin="10,0,0,2" FontSize="12.5"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                    <TextBlock Text="{Binding AdminBadge}" Foreground="{StaticResource Muted}" FontSize="12" />
                </Border>
                <Button Content="Установить драйвер PawnIO" AutomationProperties.AutomationId="BtnDriver" Style="{StaticResource AccentButton}"
                        Visibility="{Binding ShowInstallDriver, Converter={StaticResource BoolToVis}}"
                        Click="InstallDriver_Click" />
                <Button Content="Запустить от администратора" AutomationProperties.AutomationId="BtnElevate" Style="{StaticResource AccentButton}"
                        Visibility="{Binding ShowElevate, Converter={StaticResource BoolToVis}}"
                        Click="Elevate_Click" />
                <Button Content="{Binding PauseText}" AutomationProperties.AutomationId="BtnPausePoll" Click="Pause_Click" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- Баннер -->
        <Border Grid.Row="1" Background="#2A2118" BorderBrush="#5C4A22" BorderThickness="1" CornerRadius="8"
                Padding="12,9" Margin="0,0,0,12"
                Visibility="{Binding ShowBanner, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding BannerTitle}" FontWeight="SemiBold" Foreground="{StaticResource Warm}" />
                <TextBlock Text="{Binding BannerText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- Карточки датчиков -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ПРОЦЕССОР" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding CpuTempText}" FontSize="26" FontWeight="Bold" Foreground="{Binding CpuTempBrush}" />
                    <TextBlock Text="{Binding CpuName}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ВИДЕОКАРТА" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding GpuTempText}" FontSize="26" FontWeight="Bold" Foreground="{Binding GpuTempBrush}" />
                    <TextBlock Text="{Binding GpuName}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ЗАГРУЗКА CPU" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding CpuLoadText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="{Binding CpuPowerText}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ЗАГРУЗКА GPU" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding GpuLoadText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="{Binding GpuPowerText}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ПАМЯТЬ" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding RamText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text}" />
                    <TextBlock Text="использовано / всего" FontSize="10.5" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="5" Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="ТЕРМОМОДЕЛЬ" FontSize="10.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{Binding ModelText}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding ModelBrush}" />
                    <TextBlock Text="{Binding ModelHint}" FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Основная часть -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="440" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="Завершить процесс" AutomationProperties.AutomationId="BtnKill" Style="{StaticResource DangerButton}" Click="Kill_Click" />
                    <Button Content="Завершить с дочерними" AutomationProperties.AutomationId="BtnKillTree" Style="{StaticResource DangerButton}" Click="KillTree_Click" />
                    <Button Content="Пауза процесса" AutomationProperties.AutomationId="BtnSuspend" Click="Suspend_Click" />
                    <Button Content="Продолжить процесс" AutomationProperties.AutomationId="BtnResume" Click="Resume_Click" />
                    <Button Content="{Binding CoolText}" AutomationProperties.AutomationId="BtnCool" Style="{StaticResource AccentButton}" Click="Cool_Click" />
                    <Button Content="Проверить вклад (20 с)" AutomationProperties.AutomationId="BtnTest" Style="{StaticResource AccentButton}" Click="Test_Click" />
                    <Button Content="Обновить сведения" AutomationProperties.AutomationId="BtnRefresh" Click="RefreshDetails_Click" Margin="0" />
                    <CheckBox Content="Сортировать по нагреву" IsChecked="{Binding AutoSort, Mode=TwoWay}"
                              Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </WrapPanel>

                <DataGrid x:Name="ProcessGrid" Grid.Row="1" AutomationProperties.AutomationId="ProcessGrid"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          SelectionChanged="Grid_SelectionChanged"
                          MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Suspended}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Warm}" />
                                    <Setter Property="Opacity" Value="0.9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Процесс" Binding="{Binding Name}" Width="165" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="55" />
                        <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="62" />
                        <DataGridTextColumn Header="GPU" Binding="{Binding GpuText}" Width="62" />
                        <DataGridTextColumn Header="RAM, МБ" Binding="{Binding RamText}" Width="72" />
                        <DataGridTextColumn Header="+°C CPU" Binding="{Binding TempCpuText}" Width="74" />
                        <DataGridTextColumn Header="+°C GPU" Binding="{Binding TempGpuText}" Width="74" />
                        <DataGridTextColumn Header="Нагрев" Binding="{Binding TempTotalText}" Width="78" />
                        <DataGridTextColumn Header="Издатель" Binding="{Binding Company}" Width="140" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Подробности процесса" FontWeight="SemiBold"
                               Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                    <TextBox Text="{Binding DetailsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="6" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Статус -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="12" />
            <TextBlock Text="{Binding StatusRightText}" Foreground="{StaticResource Muted}" FontSize="12"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>




